                    'following' => false,
                    'removed' => false,
                ],
            ]);
        }

        $follow->delete();

        event(new WorkspaceUnfollowed(
            followerId: $user->id,
            workspaceId: $workspaceId,
            context: [
                'source' => 'community.http',
            ],
