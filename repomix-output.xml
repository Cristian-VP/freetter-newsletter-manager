                        activeFormats.unorderedList ? "bg-white/20 text-white" : "text-white/90 hover:bg-white/12"
                      }`}
                      aria-label="Lista con viñetas"
                    >
                      <List className="h-4 w-4" />
                    </button>
                    <button
                      type="button"
                      onMouseDown={(event) => event.preventDefault()}
