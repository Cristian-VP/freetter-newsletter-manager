                icon={UsersRound}
                label="Subscripciones"
                isActive={activeItem === "subscriptions"}
                href="/subscriptions"
                showLabel={isExpanded}
              />

              <NavItemIconButton
                icon={PencilLine}
                label="Crear"
                isActive={activeItem === "create"}
                href="/newsletters/resume"
                showLabel={isExpanded}
              />

              <NavItemIconButton
                icon={Plus}
                label="Nuevo post"
                isActive={false}
                onClick={onCreatePostClick}
                showLabel={isExpanded}
              />

              <ProfileNavAvatar
                name={userName}
                avatar={userAvatar}
                isActive={activeItem === "profile"}
