APP_NAME=freetter
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://freetter.app

# PostgreSQL local en el droplet
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=freetter
DB_USERNAME=freetter_user
DB_PASSWORD=
DB_CHARSET=utf8
DB_SCHEMA=public
DB_SSLMODE=prefer

# Redis local en el droplet
REDIS_CLIENT=phpredis
REDIS_CLUSTER=redis
REDIS_PREFIX=
REDIS_PERSISTENT=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Colas, caché y sesiones en Redis
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

VITE_APP_NAME="${APP_NAME}"

# Correo
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=no-reply@freetter.app
MAIL_FROM_NAME=Freetter

# DigitalOcean (para uso futuro con Spaces, no requerido ahora)
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ams3
# AWS_BUCKET=
# AWS_ENDPOINT=https://ams3.digitaloceanspaces.com