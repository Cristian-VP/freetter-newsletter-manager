{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "npx",
        "--yes",
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "laravel-boost": {
      "type": "local",
      "command": [
        "docker",
        "exec",
        "-i",
        "devcontainer-cli-1",
        "php",
        "/workspaces/freetter-newsletter-manager/artisan",
        "boost:mcp"
      ],
      "enabled": true
    }
  }
}
