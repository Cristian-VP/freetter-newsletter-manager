{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "freetter-planner",
  "agent": {
    "plan": {
      "disable": true
    },
    "build": {
      "disable": true
    },
    "freetter-planner": {
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-pro"
    },
    "freetter-implementer": {
      "mode": "subagent",
      "model": "opencode/qwen3.6-plus",
      "permission": {
        "bash": {
          "ls *": "allow",
          "cat *": "allow",
          "grep *": "allow",
          "git status*": "allow",
          "php artisan*": "deny",
          "phpunit*": "deny",
          "composer*": "deny",
          "npm*": "deny",
          "node*": "deny",
          "npx*": "deny",
          "docker*": "deny",
          "git add*": "deny",
          "git commit*": "deny",
          "git push*": "deny",
          "git reset*": "deny",
          "git revert*": "deny",
          "git clean*": "deny",
          "psql*": "deny",
          "mysql*": "deny",
          "*": "ask"
        }
      }
    }
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "npx",
        "--yes",
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "laravel-boost": {
      "type": "local",
      "command": [
        "php",
        "artisan",
        "boost:mcp"
      ],
      "enabled": true 
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp",
      "enabled": true
    },
    "digitalocean": {
      "type": "local",
      "command": ["npx", "-y", "@digitalocean/mcp"],
      "enabled": true,
      "environment": {
        "DIGITALOCEAN_API_TOKEN": "${env:DIGITALOCEAN_API_KEY}"
      }
    },
    "resend": {
      "type": "local",
      "command": ["npx", "-y", "resend-mcp"],
      "enabled": true,
      "environment": {
        "RESEND_API_KEY": "${env:RESEND_API_KEY}"
      }
    }
  }
}
