{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "npx",
        "--yes",
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "laravel-boost": {
      "type": "local",
      "command": [
        "docker",
        "exec",
        "-i",
        "devcontainer-cli-1",
        "php",
        "/workspaces/freetter-newsletter-manager/artisan",
        "boost:mcp"
      ],
      "enabled": true
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp",
      "enabled": true
    },
    "digitalocean": {
      "type": "local",
      "command": ["npx", "-y", "@digitalocean/mcp"],
      "enabled": true,
      "environment": {
        "DIGITALOCEAN_API_TOKEN": "${env:DIGITALOCEAN_API_KEY}"
      }
    },
    "resend": {
      "type": "local",
      "command": ["npx", "-y", "resend-mcp"],
      "enabled": true,
      "environment": {
        "RESEND_API_KEY": "${env:RESEND_API_KEY}"
      }
    }
  }
}
